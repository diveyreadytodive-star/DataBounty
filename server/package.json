{
  "name": "@draftproof/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./api-types": {
      "types": "./dist/api/types.d.ts",
      "default": "./dist/api/types.js"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "setup:seal-delegates": "node scripts/setup-seal-delegates.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@mysten/seal": "^1.4.8",
    "@mysten/sui": "^2.0.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
