# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
AUTH_DOMAIN=127.0.0.1:3000
AUTH_NONCE_TTL_SECONDS=300
SESSION_TTL_SECONDS=3600
COOKIE_SECRET=replace-with-a-random-secret
SQLITE_PATH=./data/databounty.db
LOG_LEVEL=info

# Sui Testnet
SUI_NETWORK=testnet
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Current DataBounty package on Sui Testnet. An absent package disables chain actions.
DATABOUNTY_PACKAGE_ID=0xf7923bd34625af96c40e27187371f231fca6bca7d25d244fe72244ec9a89b0aa

# Walrus: configure one write route; publisher is preferred
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_UPLOAD_RELAY_URL=
WALRUS_STORAGE_EPOCHS=5

# Seal
SEAL_KEY_SERVER_IDS=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
SEAL_AGGREGATOR_URL=https://seal-aggregator-testnet.mystenlabs.com
SEAL_THRESHOLD=1
SEAL_API_KEY_NAME=
SEAL_API_KEY=

# One reviewer delegate. The private key stays server-side; the public address is
# returned by GET /api/agents and is the only address the UI can grant/revoke.
REVIEWER_DELEGATE_PRIVATE_KEY=
REVIEWER_DELEGATE_ADDRESS=

# OpenAI-compatible provider. The configured model is never silently replaced.
# Local MLX example after `npm run setup:local-ai` and `npm run start:local-ai`:
# AI_PROVIDER=mlx-local
# AI_BASE_URL=http://127.0.0.1:8092/v1
# AI_API_KEY=local-placeholder  # Nonsecret placeholder; MLX does not require an API key.
# AI_MODEL=mlx-community/Qwen3-1.7B-4bit
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Browser-visible configuration only
# Public deployments set VITE_PUBLIC_MODE=preview at build time for a static read-only UI.
VITE_PUBLIC_MODE=local
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_SUI_NETWORK=testnet
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Must match DATABOUNTY_PACKAGE_ID. Leave unset to disable browser chain actions.
VITE_DATABOUNTY_PACKAGE_ID=0xf7923bd34625af96c40e27187371f231fca6bca7d25d244fe72244ec9a89b0aa
VITE_SEAL_KEY_SERVER_IDS=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
VITE_SEAL_AGGREGATOR_URL=https://seal-aggregator-testnet.mystenlabs.com
VITE_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
