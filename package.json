{
  "name": "draftproof",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w server",
    "start": "npm run start -w @draftproof/server",
    "setup:local-ai": "bash scripts/setup-local-ai.sh",
    "start:local-ai": "bash scripts/start-local-ai.sh"
  }
}
